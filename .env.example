# XTJS 后端环境变量示例
# 复制为 .env 后按需修改。docker compose 会自动读取本目录的 .env 做变量替换，
# 本地直跑（python run.py）时 pydantic-settings 也会读取 .env。
# 说明：OCR/缓存等其余变量已在 docker-compose.yml 内置默认值，按需覆盖即可，
#       此处仅列出认证功能新增的关键项。

# —— 认证与账号安全 ——
# JWT 签名密钥：生产环境务必改成一段足够长的随机串（如 `openssl rand -hex 32` 生成），切勿沿用默认值。
JWT_SECRET_KEY=please-change-to-a-long-random-secret
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# 连续登录失败达到该次数后锁定账号
AUTH_MAX_FAILED_ATTEMPTS=5
# 账号锁定时长（分钟）
AUTH_LOCK_MINUTES=15
# 新密码/重置密码的最小长度（同时要求字母+数字）
AUTH_PASSWORD_MIN_LENGTH=8

# —— 初始管理员（首次启动自动创建，用于引导首个账号）——
# 留空 AUTH_INITIAL_ADMIN_PASSWORD 则不创建；创建后建议尽快登录并修改密码。
AUTH_INITIAL_ADMIN_USERNAME=admin
AUTH_INITIAL_ADMIN_PASSWORD=

# —— 数据库（如需覆盖 compose 默认值）——
# DATABASE_URL=postgresql://admin:password@postgres:5432/xtjs_db

# —— 结果按需读取与缓存 ——
# XTJS_REVIEW_INDEX_ENABLED=true
# 单条 Redis JSON 缓存上限，默认 8 MiB；超限时直接返回权威存储数据而不写缓存。
# XTJS_CACHE_MAX_ENTRY_BYTES=8388608

# —— 重复内容内错别字检查 ——
# TYPO_CHECK_ENABLED=true
# TYPO_CHECK_VISIBLE=true
# v5 原文检测分数与字形相似门槛；MacBERT 候选门槛固定为 0.10／0.30 倍。
# TYPO_DETECTOR_THRESHOLD=0.99
# TYPO_GLYPH_THRESHOLD=0.75

# —— 对象存储：切换为阿里云 OSS（S3 兼容端点）——
# 前提：已在 OSS 控制台创建同地域私有桶 + RAM 子账号（仅授权该桶读写）。
# 本机为阿里云 ECS 时建议用同地域内网端点，速度快且免公网流量费。
# MINIO_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com   # 公网可用 oss-cn-hangzhou.aliyuncs.com
# MINIO_ACCESS_KEY=<RAM AccessKey ID>
# MINIO_SECRET_KEY=<RAM AccessKey Secret>
# MINIO_SECURE=true
# MINIO_REGION=cn-hangzhou
# MINIO_BUCKET_NAME=<OSS 桶名>

# —— 商务审查后台任务 ——
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# BUSINESS_REVIEW_QUEUE=business_review
# BUSINESS_REVIEW_TASK_TIMEOUT_SECONDS=900
# BUSINESS_REVIEW_TASK_HEARTBEAT_SECONDS=5
# BUSINESS_REVIEW_TASK_STALE_SECONDS=30
# BUSINESS_REVIEW_DISPATCH_INTERVAL_SECONDS=10
# BUSINESS_REVIEW_EVIDENCE_CACHE_ROOT=/app/.ocr_runtime/business-evidence-cache
# SIGNATURE_PRESENCE_ENABLED=true
# SIGNATURE_PRESENCE_MODEL_PATH=/app/models/yolos-small-signature-detection
# SIGNATURE_PRESENCE_MODEL_REVISION=238c12505dbfb4bbcfed325a00de9218b4ddeaa0
# SIGNATURE_PRESENCE_DEVICE=cpu
# SIGNATURE_PRESENCE_THRESHOLD=0.50
# SIGNATURE_PRESENCE_TIMEOUT_SECONDS=120
# SIGNATURE_PRESENCE_RENDER_DPI=300
