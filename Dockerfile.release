# Reuse the last verified runtime and replace the application tree completely.
# This keeps OCR/CUDA/model dependencies identical while ensuring removed
# Python modules cannot survive as files from an older image layer.
FROM project-xtjs:optional-scope-exclusion-v1-20260923
WORKDIR /app
LABEL org.opencontainers.image.version="review-hardening-v2-20260924"
RUN find /app/app -mindepth 1 -delete \
    && find /app/tools -mindepth 1 -delete
COPY app/ /app/app/
COPY tools/ /app/tools/
RUN python -m compileall -q /app/app /app/tools
